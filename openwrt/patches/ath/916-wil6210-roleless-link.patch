wil6210: roleless link between PCPs (module parameter roleless_link)

With oob_mode=1 two PCPs find each other in A-BFT and beamform, but stop at
READY_FOR_ASSOC: nothing drives the association, since neither is a station.
SparRAW firmware 6.4 can adopt such a connection as a "direct PBSS member"
(the vendor's own path that skips the Assoc frame exchange and ends in
WMI_PBSS_JOINED_EVENTID, handled by patch 913) when asked to in
WMI_PCP_START.  Pass that request in reserved[0] when roleless_link=1.
Older firmware reads neither byte 7 nor the flag.
--- a/drivers/net/wireless/ath/wil6210/wmi.c
+++ b/drivers/net/wireless/ath/wil6210/wmi.c
@@ -2323,6 +2323,11 @@ int wmi_rbufcap_cfg(struct wil6210_priv
 	return rc;
 }
 
+static bool roleless_link;
+module_param(roleless_link, bool, 0444);
+MODULE_PARM_DESC(roleless_link,
+		 " link with peers found by A-BFT without roles (SparRAW FW 6.4, needs oob_mode=1)");
+
 int wmi_pcp_start(struct wil6210_vif *vif, int bi, u8 wmi_nettype,
 		  u8 chan, u8 wmi_edmg_chan, u8 hidden_ssid, u8 is_go)
 {
@@ -2353,6 +2358,11 @@ int wmi_pcp_start(struct wil6210_vif *vi
 	if (!vif->privacy)
 		cmd.disable_sec = 1;
 
+	if (roleless_link) {
+		cmd.reserved[0] |= WMI_PCP_START_ROLELESS_LINK;
+		wil_info(wil, "PCP start with roleless link\n");
+	}
+
 	if ((cmd.pcp_max_assoc_sta > WIL6210_MAX_CID) ||
 	    (cmd.pcp_max_assoc_sta <= 0)) {
 		wil_err(wil, "unexpected max_assoc_sta %d\n",
--- a/drivers/net/wireless/ath/wil6210/wmi.h
+++ b/drivers/net/wireless/ath/wil6210/wmi.h
@@ -824,6 +824,13 @@ enum wmi_ap_sme_offload_mode {
 };
 
 /* WMI_PCP_START_CMDID */
+/* reserved[0] bit: link with any peer found by A-BFT without roles and
+ * without an Assoc frame exchange (vendor "direct PBSS member" path, ends in
+ * WMI_PBSS_JOINED_EVENTID).  Understood by SparRAW FW 6.4; older firmware
+ * ignores the byte.  Needs oob_mode=1 (Discovery A-BFT).
+ */
+#define WMI_PCP_START_ROLELESS_LINK	BIT(0)
+
 struct wmi_pcp_start_cmd {
 	__le16 bcon_interval;
 	u8 pcp_max_assoc_sta;
@@ -832,6 +839,7 @@ struct wmi_pcp_start_cmd {
 	/* enum wmi_channel WMI_CHANNEL_9..WMI_CHANNEL_12 */
 	u8 edmg_channel;
 	u8 raw_mode;
+	/* reserved[0]: WMI_PCP_START_ROLELESS_LINK (SparRAW FW 6.4) */
 	u8 reserved[3];
 	/* A-BFT length override if non-0 */
 	u8 abft_len;
