--- a/drivers/net/wireless/ath/wil6210/wmi.c
+++ b/drivers/net/wireless/ath/wil6210/wmi.c
@@ -2123,11 +2123,37 @@ out:
 	return rc;
 }
 
+/* Sparrow FW 6.2.0.1000 builds reuse WMI_ECHO_CMDID as "set beacon
+ * interval": its handler takes bits 0..15 of the echo value as the beacon
+ * interval in TU (FW global 0x8002d4) and bits 16..23 as an "align" byte.
+ * A non-AP STA gets its BI timer programmed from that global at
+ * WMI_CONNECT (l2_mgr::connect -> RADIO_MGR set_primary_channel -> ucode
+ * RX_ON), so the historic 0x12345678 made the STA BI 0x5678 TU (~22.7 s):
+ * no BI events, a stuck MAC_MON slot, false "bad beacons" link losses every
+ * 20 BIs and no detection of a lost AP at all.  Send a sane default here;
+ * wil_cfg80211_connect() then adopts the AP's beacon period before joining
+ * (IEEE 802.11-2020 11.1.3.3.1).  FW 4.1.0.1000 and linux-firmware builds
+ * only echo the value back (a 4.1 STA keeps a fixed 100 TU period).
+ */
+#define WIL_DEFAULT_BCON_INT_TU	100
+
+int wmi_set_sta_bcon_int(struct wil6210_priv *wil, u16 bcon_int_tu)
+{
+	struct wil6210_vif *vif = ndev_to_vif(wil->main_ndev);
+	struct wmi_echo_cmd cmd = {
+		.value = cpu_to_le32(bcon_int_tu),	/* align byte = 0 */
+	};
+
+	return wmi_call(wil, WMI_ECHO_CMDID, vif->mid, &cmd, sizeof(cmd),
+			WMI_ECHO_RSP_EVENTID, NULL, 0,
+			WIL_WMI_CALL_GENERAL_TO_MS);
+}
+
 int wmi_echo(struct wil6210_priv *wil)
 {
 	struct wil6210_vif *vif = ndev_to_vif(wil->main_ndev);
 	struct wmi_echo_cmd cmd = {
-		.value = cpu_to_le32(0x12345678),
+		.value = cpu_to_le32(WIL_DEFAULT_BCON_INT_TU),
 	};
 
 	return wmi_call(wil, WMI_ECHO_CMDID, vif->mid, &cmd, sizeof(cmd),
