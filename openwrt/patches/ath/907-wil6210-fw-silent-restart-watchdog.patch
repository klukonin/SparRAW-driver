+ * it yet or it falls outside the known FW mappings.
+ */
+static void __iomem *wil_fw_log_ring(struct wil6210_priv *wil)
 {
 	u32 addr = wil_r(wil, RGF_USER_USAGE_1);
-	void __iomem *dst = NULL;
-	u32 word;
 	int i;
 
-	if (!level)
-		return;
-
-	if (!addr) {
-		wil_err(wil, "FW log address not published by FW\n");
-		return;
-	}
+	if (!addr)
+		return NULL;
 
 	for (i = 0; i < ARRAY_SIZE(fw_mapping); i++) {
 		struct fw_map *map = &fw_mapping[i];
 
 		if (!map->to || addr < map->from || addr >= map->to)
 			continue;
-		dst = (u8 __iomem *)wil->csr + HOSTADDR(map->host) +
-		      (addr - map->from);
-		break;
+		return (u8 __iomem *)wil->csr + HOSTADDR(map->host) +
+		       (addr - map->from);
 	}
 
+	wil_err(wil, "FW log address 0x%08x outside FW mappings\n", addr);
+	return NULL;
+}
+
+void wil_fw_log_enable(struct wil6210_priv *wil, u8 level)
+{
+	void __iomem *dst;
+	u32 word;
+	int i;
+
+	if (!level)
+		return;
+
+	dst = wil_fw_log_ring(wil);
 	if (!dst) {
-		wil_err(wil, "FW log address 0x%08x outside FW mappings\n",
-			addr);
+		wil_err(wil, "FW log address not published by FW\n");
 		return;
 	}
 
+	/* remember it: the level can also come from debugfs, and the watchdog
+	 * needs to know whether the marker is armed at all
+	 */
+	wil->fw_log_level = level;
+
 	/* one level byte per module, all set the same */
 	word = level * 0x01010101u;
 	for (i = 0; i < 16; i += 4)
@@ -1667,7 +1689,78 @@ void wil_fw_log_enable(struct wil6210_pr
 	wmb();
 
 	wil_info(wil, "FW log enabled at 0x%08x, level mask 0x%02x\n",
-		 addr, level);
+		 wil_r(wil, RGF_USER_USAGE_1), level);
+}
+
+/* All 16 per-module level bytes zero: nobody armed this ring, i.e. the FW
+ * came up fresh.  Checking all of them keeps a partially muted log (some
+ * modules set to 0 on purpose) from looking like a restart.
+ */
+static bool wil_fw_log_levels_zeroed(void __iomem *ring)
+{
+	int i;
+
+	for (i = 0; i < 16; i += 4)
+		if (readl((u8 __iomem *)ring + sizeof(u32) + i))
+			return false;
+	return true;
+}
+
+/*
+ * Catch a firmware restart that the firmware does not report.
+ *
+ * Under sustained TX load the FW has been seen to restart itself without
+ * raising the error interrupt: no assert code, no event, the TX ring simply
+ * stays stopped and WMI only starts timing out once something asks the FW for
+ * anything. By then resetting the device hangs the board and only a power
+ * cycle recovers it, so the restart has to be noticed while the chip is still
+ * sane.
+ *
+ * The marker is the FW log level bytes: they live in FW RAM, the driver is
+ * their only writer, and a restarted FW comes up with them zeroed.
+ *
+ * A write pointer that stands still is NOT treated as a hang: FW 6.2, and a
+ * 4.1 station before association, legitimately log nothing for seconds, and
+ * such a check reset healthy links every 6-18 s.
+ */
+static void wil_fw_watchdog_work(struct work_struct *work)
+{
+	struct wil6210_priv *wil = container_of(work, struct wil6210_priv,
+						fw_watchdog_work.work);
+	void __iomem *ring;
+
+	if (!fw_watchdog_ms || !wil->fw_log_level)
+		return;
+
+	if (test_bit(wil_status_fwready, wil->status) &&
+	    !test_bit(wil_status_resetting, wil->status)) {
+		ring = wil_fw_log_ring(wil);
+		if (ring && wil_fw_log_levels_zeroed(ring)) {
+			wil_err(wil,
+				"FW restarted without notifying the host, recovering\n");
+			wil_fw_error_recovery(wil);
+			return;
+		}
+	}
+
+	schedule_delayed_work(&wil->fw_watchdog_work,
+			      msecs_to_jiffies(fw_watchdog_ms));
+}
+
+void wil_fw_watchdog_start(struct wil6210_priv *wil)
+{
+	if (!fw_watchdog_ms)
+		return;
+
+	if (!wil->fw_log_level) {
+		wil_err(wil,
+			"fw_watchdog_ms needs the FW log armed, watchdog not started\n");
+		return;
+	}
+
+	wil_info(wil, "FW watchdog every %u ms\n", fw_watchdog_ms);
+	mod_delayed_work(system_wq, &wil->fw_watchdog_work,
+			 msecs_to_jiffies(fw_watchdog_ms));
 }
 
