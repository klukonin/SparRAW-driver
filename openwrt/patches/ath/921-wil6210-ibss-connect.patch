wil6210: IBSS peer link reported by the firmware

SparRAW firmware 6.4 mesh links DMG IBSS members by beamforming in the
DTI (IEEE 802.11-2020 10.42.6) without association and reports each
link with WMI_CONNECT_EVENTID. The event was dropped as "unhandled
iftype" for an IBSS interface, so the TX ring stayed pending and no
frame went out. Treat the peer as a new station of the cell, as for
an AP; when the firmware reports the peer lost, remove the station
from cfg80211 as well.
--- a/drivers/net/wireless/ath/wil6210/wmi.c
+++ b/drivers/net/wireless/ath/wil6210/wmi.c
@@ -1202,6 +1202,24 @@ static void wmi_evt_connect(struct wil62
 				 GFP_KERNEL);
 
 		kfree(sinfo);
+	} else if (wdev->iftype == NL80211_IFTYPE_ADHOC) {
+		/* SparRAW FW 6.4 mesh: a DMG IBSS member beamformed with a peer
+		 * (SLS in the DTI, IEEE 802.11-2020 10.42.6) and the firmware
+		 * reports the link with this event; there is no association
+		 * in an IBSS, the peer is a new station of the cell
+		 */
+		if (rc)
+			goto out;
+
+		sinfo = kzalloc_obj(*sinfo);
+		if (!sinfo) {
+			rc = -ENOMEM;
+			goto out;
+		}
+		sinfo->generation = wil->sinfo_gen++;
+		cfg80211_new_sta(ndev->ieee80211_ptr, evt->bssid, sinfo,
+				 GFP_KERNEL);
+		kfree(sinfo);
 	} else {
 		wil_err(wil, "unhandled iftype %d for CID %d\n", wdev->iftype,
 			evt->cid);
--- a/drivers/net/wireless/ath/wil6210/main.c
+++ b/drivers/net/wireless/ath/wil6210/main.c
@@ -303,6 +303,7 @@ __acquires(&sta->tid_rx_lock) __releases
 		switch (wdev->iftype) {
 		case NL80211_IFTYPE_AP:
 		case NL80211_IFTYPE_P2P_GO:
+		case NL80211_IFTYPE_ADHOC:	/* IBSS peer, SparRAW FW 6.4 mesh */
 			/* AP-like interface */
 			cfg80211_del_sta(wdev, sta->addr, GFP_KERNEL);
 			break;
