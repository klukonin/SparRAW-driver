+/*
+ * Непрерывный сбор трассировки ucode.
+ *
+ * Кольцо ucode крошечное: 256 слов, что на маячащем узле около полутора
+ * секунд истории. Вычерпывать его из userspace бесполезно - между двумя
+ * чтениями часть записей затирается, и поток рвётся (именно так мы приняли
+ * потерю выборки за пропуски маяков). Поэтому драйвер сам опрашивает кольцо
+ * каждые uc_trace_ms и дописывает НОВЫЕ слова в большой буфер, который
+ * читается одним куском из debugfs.
+ *
+ * Формат в буфере - последовательность пачек:
+ *     u32 magic = WIL_UC_TRACE_MAGIC
+ *     u32 count          - сколько слов в пачке
+ *     u64 ktime_ns       - момент чтения на хосте
+ *     u32 words[count]   - слова кольца в порядке записи
+ */
+static void wil_uc_trace_put(struct wil6210_priv *wil, const void *p, size_t n)
+{
+	size_t tail = WIL_UC_TRACE_SIZE - wil->uc_trace_head;
+
+	if (n > tail) {
+		memcpy(wil->uc_trace_buf + wil->uc_trace_head, p, tail);
+		memcpy(wil->uc_trace_buf, (const u8 *)p + tail, n - tail);
+		wil->uc_trace_head = n - tail;
+		wil->uc_trace_wrapped = true;
+	} else {
+		memcpy(wil->uc_trace_buf + wil->uc_trace_head, p, n);
+		wil->uc_trace_head += n;
+		if (wil->uc_trace_head == WIL_UC_TRACE_SIZE) {
+			wil->uc_trace_head = 0;
+			wil->uc_trace_wrapped = true;
+		}
+	}
+}
+
+static void wil_uc_trace_work(struct work_struct *work)
+{
+	struct wil6210_priv *wil = container_of(work, struct wil6210_priv,
+						uc_trace_work.work);
+	void __iomem *ring;
+	u32 hdr[4], wptr, n, i;
+	u32 *words = wil->uc_trace_tmp;	/* 1 КБ, на стек не влезает */
+
+	if (!uc_trace_ms || !wil->uc_trace_buf || !words)
+		return;
+
+	if (!test_bit(wil_status_fwready, wil->status) ||
+	    test_bit(wil_status_resetting, wil->status))
+		goto again;
+
+	ring = wil_log_ring(wil, RGF_USER_USAGE_2, false);
+	if (!ring)
+		goto again;
+
+	wptr = readl(ring);
+	if (wptr == wil->uc_trace_wptr)
+		goto again;
+
+	n = wptr - wil->uc_trace_wptr;
+	if (n > WIL_UC_RING_ENTRIES) {	/* не успели, часть затёрта */
+		wil->uc_trace_lost += n - WIL_UC_RING_ENTRIES;
+		n = WIL_UC_RING_ENTRIES;
+	}
+	for (i = 0; i < n; i++)
+		words[i] = readl((u8 __iomem *)ring + 0x14 +
+				 ((wptr - n + i) % WIL_UC_RING_ENTRIES) * 4);
+
+	hdr[0] = WIL_UC_TRACE_MAGIC;
+	hdr[1] = n;
+	*(u64 *)&hdr[2] = ktime_get_ns();
+
+	spin_lock_bh(&wil->uc_trace_lock);
+	wil_uc_trace_put(wil, hdr, sizeof(hdr));
+	wil_uc_trace_put(wil, words, n * sizeof(u32));
+	spin_unlock_bh(&wil->uc_trace_lock);
+	wil->uc_trace_wptr = wptr;
+
+again:
+	if (uc_trace_ms)
+		schedule_delayed_work(&wil->uc_trace_work,
+				      msecs_to_jiffies(uc_trace_ms));
+}
+
+void wil_uc_trace_start(struct wil6210_priv *wil)
+{
+	if (!uc_trace_ms)
+		return;
+
+	if (!wil->uc_trace_buf) {
+		wil->uc_trace_buf = vzalloc(WIL_UC_TRACE_SIZE);
+		wil->uc_trace_tmp = kcalloc(WIL_UC_RING_ENTRIES, sizeof(u32),
+					    GFP_KERNEL);
+		if (!wil->uc_trace_buf || !wil->uc_trace_tmp) {
+			wil_err(wil, "no memory for the ucode trace buffer\n");
+			vfree(wil->uc_trace_buf);
+			kfree(wil->uc_trace_tmp);
+			wil->uc_trace_buf = NULL;
+			wil->uc_trace_tmp = NULL;
+			return;
+		}
+	}
+	wil->uc_trace_head = 0;
+	wil->uc_trace_wrapped = false;
+	wil->uc_trace_lost = 0;
+	wil->uc_trace_wptr = 0;
+	wil_info(wil, "ucode trace collector every %u ms, buffer %u KB\n",
+		 uc_trace_ms, WIL_UC_TRACE_SIZE / 1024);
+	mod_delayed_work(system_wq, &wil->uc_trace_work,
+			 msecs_to_jiffies(uc_trace_ms));
+}
+
