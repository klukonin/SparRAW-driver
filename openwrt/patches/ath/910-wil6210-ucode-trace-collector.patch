wil6210: collect the ucode trace ring in the driver

The ucode keeps its own trace ring, and it is tiny: 256 words, about a second
and a half of history on a beaconing node. Draining it from userspace does not
work - between two reads part of it is overwritten and the stream silently
loses records, which is easy to mistake for the device skipping work.

Poll it from the driver every uc_trace_ms instead, append only the words that
are new since the last pass into a 1 MB buffer, and hand the whole thing out
through debugfs uc_trace. Each batch carries a magic, the word count and a
host timestamp, so userspace can reassemble a continuous, timestamped trace
and see where (if anywhere) it lost data.

0, the default, keeps the collector off.
--- a/drivers/net/wireless/ath/wil6210/debugfs.c
+++ b/drivers/net/wireless/ath/wil6210/debugfs.c
@@ -10,6 +10,7 @@
 #include <linux/pci.h>
 #include <linux/rtnetlink.h>
 #include <linux/power_supply.h>
+#include <linux/vmalloc.h>
 #include "wil6210.h"
 #include "wmi.h"
 #include "txrx.h"
@@ -1539,6 +1540,49 @@ static ssize_t wil_write_file_recovery(s
 	return rc;
 }
 
+/*---------ucode trace------------*/
+/* Слитый из кольца поток ucode-трассировки: отдаём одним куском, дальше
+ * разбирает userspace (pайки: magic, count, ktime, слова).
+ */
+static ssize_t wil_read_file_uc_trace(struct file *file, char __user *user_buf,
+				      size_t count, loff_t *ppos)
+{
+	struct wil6210_priv *wil = file->private_data;
+	size_t len, off;
+	void *tmp;
+	ssize_t rc;
+
+	if (!wil->uc_trace_buf)
+		return 0;
+
+	tmp = vmalloc(WIL_UC_TRACE_SIZE);
+	if (!tmp)
+		return -ENOMEM;
+
+	spin_lock_bh(&wil->uc_trace_lock);
+	if (wil->uc_trace_wrapped) {
+		/* самый старый байт идёт сразу за головой */
+		off = WIL_UC_TRACE_SIZE - wil->uc_trace_head;
+		memcpy(tmp, wil->uc_trace_buf + wil->uc_trace_head, off);
+		memcpy(tmp + off, wil->uc_trace_buf, wil->uc_trace_head);
+		len = WIL_UC_TRACE_SIZE;
+	} else {
+		memcpy(tmp, wil->uc_trace_buf, wil->uc_trace_head);
+		len = wil->uc_trace_head;
+	}
+	spin_unlock_bh(&wil->uc_trace_lock);
+
+	rc = simple_read_from_buffer(user_buf, count, ppos, tmp, len);
+	vfree(tmp);
+
+	return rc;
+}
+
+static const struct file_operations fops_uc_trace = {
+	.read  = wil_read_file_uc_trace,
+	.open  = simple_open,
+};
+
 /*---------FW log level------------*/
 /* Write the per-module level bytes into the FW log ring header right now,
  * without resetting the device. Needed because the FW can restart on its own
@@ -1561,6 +1605,10 @@ static ssize_t wil_write_file_fw_log_lev
 	 * point where the silent-restart watchdog can start without a reset
 	 */
 	wil_fw_watchdog_start(wil);
+	/* same for the trace collector: arming it must not need a device
+	 * reset, which is unsafe once the firmware is in trouble
+	 */
+	wil_uc_trace_start(wil);
 
 	return count;
 }
