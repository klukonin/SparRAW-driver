@@ -97,6 +97,8 @@ enum wmi_fw_capability {
 	WMI_FW_CAPABILITY_TX_REQ_EXT			= 25,
 	WMI_FW_CAPABILITY_CHANNEL_4			= 26,
 	WMI_FW_CAPABILITY_IPA				= 27,
+	/* SparRAW FW 6.4: reassociation of an associated STA in place */
+	WMI_FW_CAPABILITY_REASSOC_INPLACE		= 28,
 	WMI_FW_CAPABILITY_TEMPERATURE_ALL_RF		= 30,
 	WMI_FW_CAPABILITY_SPLIT_REKEY			= 31,
 	WMI_FW_CAPABILITY_MAX,
@@ -203,6 +205,7 @@ enum wmi_command_id {
 	WMI_LED_CFG_CMDID				= 0x858,
 	/* SparRAW FW 6.4 mesh: BSSID of the DMG IBSS cell, sent before PCP_START */
 	WMI_IBSS_BSSID_CMDID				= 0x85a,
+	WMI_REASSOC_INPLACE_CFG_CMDID			= 0x85b,
 	WMI_SET_CONNECT_SNR_THR_CMDID			= 0x85B,
 	WMI_SET_ACTIVE_SILENT_RSSI_TABLE_CMDID		= 0x85C,
 	WMI_RF_PWR_ON_DELAY_CMDID			= 0x85D,
@@ -821,6 +824,16 @@ struct wmi_ibss_bssid_cmd {
 	u8 reserved[2];
 } __packed;
 
+/* WMI_REASSOC_INPLACE_CFG_CMDID (SparRAW FW 6.4, capability
+ * WMI_FW_CAPABILITY_REASSOC_INPLACE), no reply: the AP answers a
+ * (Re)Association Request of an associated STA in place and reports it with
+ * WMI_CONNECT_EVENT for the same CID (IEEE 802.11-2020 11.3.5.5)
+ */
+struct wmi_reassoc_inplace_cfg_cmd {
+	u8 enable;
+	u8 reserved[3];
+} __packed;
