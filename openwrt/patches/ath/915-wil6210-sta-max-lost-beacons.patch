+/* Make the FW link-loss detector follow dot11MaxLostBeacons of the joined
+ * BSS: the "bad beacons" detector disconnects after that many consecutive
+ * beacon intervals without a beacon from the AP.  Read the connection's
+ * current settings and write them back with only the threshold changed.
+ * Runs from wmi_wq: wmi_call() cannot be used from the event handler.
+ */
+void wil_lm_cfg_worker(struct work_struct *work)
+{
+	struct wil6210_vif *vif = container_of(work, struct wil6210_vif,
+					       lm_cfg_worker);
+	struct wil6210_priv *wil = vif_to_wil(vif);
+	u8 cid = vif->lm_cfg_cid, max_lost = vif->max_lost_beacons;
+	struct wmi_link_maintain_cfg_read_cmd rd = { .cid = cpu_to_le32(cid) };
+	struct {
+		struct wmi_cmd_hdr wmi;
+		struct wmi_link_maintain_cfg_read_done_event evt;
+	} __packed rd_reply = {
+		.evt = {.status = cpu_to_le32(WMI_LINK_MAINTAIN_CFG_RESPONSE_STATUS_BAD_ARGUMENT)},
+	};
+	struct wmi_link_maintain_cfg_write_cmd wr = {
+		.cfg_type = cpu_to_le32(WMI_LINK_MAINTAIN_CFG_TYPE_CUSTOM),
+		.cid = cpu_to_le32(cid),
+	};
+	struct {
+		struct wmi_cmd_hdr wmi;
+		struct wmi_link_maintain_cfg_write_done_event evt;
+	} __packed wr_reply = {
+		.evt = {.status = cpu_to_le32(WMI_LINK_MAINTAIN_CFG_RESPONSE_STATUS_BAD_ARGUMENT)},
+	};
+	int rc;
+
+	if (!max_lost)
+		return;
+
+	rc = wmi_call(wil, WMI_LINK_MAINTAIN_CFG_READ_CMDID, vif->mid,
+		      &rd, sizeof(rd), WMI_LINK_MAINTAIN_CFG_READ_DONE_EVENTID,
+		      &rd_reply, sizeof(rd_reply), WIL_WMI_CALL_GENERAL_TO_MS);
+	if (rc || rd_reply.evt.status) {
+		wil_err(wil, "link maintain cfg read cid %d: rc %d status %d\n",
+			cid, rc, le32_to_cpu(rd_reply.evt.status));
+		return;
+	}
+
+	wr.lm_cfg = rd_reply.evt.lm_cfg;
+	wr.lm_cfg.bad_beacons_num_threshold = cpu_to_le32(max_lost);
+	rc = wmi_call(wil, WMI_LINK_MAINTAIN_CFG_WRITE_CMDID, vif->mid,
+		      &wr, sizeof(wr), WMI_LINK_MAINTAIN_CFG_WRITE_DONE_EVENTID,
+		      &wr_reply, sizeof(wr_reply), WIL_WMI_CALL_GENERAL_TO_MS);
+	if (rc || wr_reply.evt.status)
+		wil_err(wil, "link maintain cfg write cid %d: rc %d status %d\n",
+			cid, rc, le32_to_cpu(wr_reply.evt.status));
+	else
+		wil_info(wil, "cid %d: bad_beacons_num_threshold %u (was %u) = MaxLostBeacons of the BSS\n",
+			 cid, max_lost,
+			 le32_to_cpu(rd_reply.evt.lm_cfg.bad_beacons_num_threshold));
+}
